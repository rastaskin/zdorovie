{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Главное окно: файл хранилища в appDataDir, копия через диалог, обновления, вход в Google и Drive API",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:scope-appdata-recursive",
    "dialog:allow-save",
    "updater:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://oauth2.googleapis.com/*"
        },
        {
          "url": "https://www.googleapis.com/*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://accounts.google.com/*"
        }
      ]
    }
  ]
}
