{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Главное окно: файл хранилища в appDataDir, сохранение копии через диалог, обновления",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:scope-appdata-recursive",
    "dialog:allow-save",
    "updater:default"
  ]
}
